{
  "name": "@prisma-next-idb/kanban-example",
  "private": true,
  "version": "0.0.5",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install",
    "test": "pnpm test:e2e",
    "contract:emit": "prisma-next contract emit",
    "contract:emit:postgres": "prisma-next contract emit --config prisma-next.config.postgres.ts",
    "migration:baseline": "prisma-next-idb generate-baseline",
    "migration:generate": "prisma-next-idb generate-migration",
    "migration:generate-space": "prisma-next-idb generate-contract-space",
    "migration:preflight": "prisma-next-idb preflight",
    "migration:postgres:new": "prisma-next migration new --config prisma-next.config.postgres.ts",
    "migration:postgres:status": "prisma-next migration status --config prisma-next.config.postgres.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:init": "prisma-next db init --config prisma-next.config.postgres.ts",
    "db:update": "prisma-next db update --config prisma-next.config.postgres.ts"
  },
  "dependencies": {
    "@prisma-next-idb/client-idb": "workspace:*",
    "@prisma-next-idb/sync-extension-idb": "workspace:*",
    "@prisma-next-idb/sync-server": "workspace:*",
    "@prisma-next/adapter-postgres": "^0.16.0",
    "@prisma-next/driver-postgres": "^0.16.0",
    "@prisma-next/family-sql": "^0.16.0",
    "@prisma-next/migration-tools": "^0.16.0",
    "@prisma-next/postgres": "^0.16.0",
    "@prisma-next/sql-builder": "^0.16.0",
    "@prisma-next/sql-contract": "^0.16.0",
    "@prisma-next/sql-contract-psl": "^0.16.0",
    "@prisma-next/sql-orm-client": "^0.16.0",
    "@prisma-next/sql-relational-core": "^0.16.0",
    "@prisma-next/sql-runtime": "^0.16.0",
    "@prisma-next/target-postgres": "^0.16.0",
    "better-auth": "^1.6.26",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@lucide/svelte": "^1.30.0",
    "@playwright/test": "^1.62.1",
    "@prisma-next-idb/adapter-idb": "workspace:*",
    "@prisma-next-idb/driver-idb": "workspace:*",
    "@prisma-next-idb/family-idb": "workspace:*",
    "@prisma-next-idb/target-idb": "workspace:*",
    "@prisma-next/contract": "^0.16.0",
    "@prisma-next/sql-contract-emitter": "^0.16.0",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.10.9",
    "@types/pg": "^8.21.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma-next": "^0.16.0",
    "shadcn-svelte": "^1.5.0",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.5",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.1"
  }
