model User {
  id           String  @id
  name         String
  email        String? @unique
  // Server-only: never synced to the client's IndexedDB (ADR 012).
  passwordHash String  @idb.exclude
  boards       Board[]
}

// Server-only audit trail. Excluded wholesale — no relations to any synced
// model, so it needs none of ADR 013's cascading FK projection (ADR 012).
model AuditLog {
  id        String   @id
  action    String
  createdAt DateTime

  @@idb.exclude
}

model Board {
  id        String   @id
  name      String
  createdAt DateTime
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  todos     Todo[]
}

model Todo {
  id          String   @id
  title       String
  description String?
  isCompleted Boolean
  createdAt   DateTime
  boardId     String
  board       Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
}
