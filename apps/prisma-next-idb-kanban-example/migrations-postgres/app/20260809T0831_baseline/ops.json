  {
    "id": "checkConstraint.changelog.changelog_operation_check",
    "label": "Add check constraint \"changelog_operation_check\" on \"changelog\".\"operation\"",
    "operationClass": "additive",
    "target": {
      "id": "postgres",
      "details": {
        "schema": "public",
        "objectType": "checkConstraint",
        "name": "changelog_operation_check",
        "table": "changelog"
      }
    },
    "precheck": [
      {
        "description": "ensure constraint \"changelog_operation_check\" does not exist",
        "sql": "SELECT NOT EXISTS (SELECT 1 AS \"one\" FROM \"pg_constraint\" AS \"c\" INNER JOIN \"pg_namespace\" AS \"n\" ON \"n\".\"oid\" = \"c\".\"connamespace\" WHERE (\"c\".\"conname\" = $1 AND \"n\".\"nspname\" = $2 AND \"c\".\"conrelid\" = to_regclass($3))) AS \"result\"",
        "params": ["changelog_operation_check", "public", "\"public\".\"changelog\""]
      }
    ],
    "execute": [
      {
        "description": "add check constraint \"changelog_operation_check\"",
        "sql": "ALTER TABLE \"public\".\"changelog\" ADD CONSTRAINT \"changelog_operation_check\" CHECK (\"operation\" IN ('create', 'update', 'delete'))"
      }
    ],
    "postcheck": [
      {
        "description": "verify constraint \"changelog_operation_check\" exists",
        "sql": "SELECT EXISTS (SELECT 1 AS \"one\" FROM \"pg_constraint\" AS \"c\" INNER JOIN \"pg_namespace\" AS \"n\" ON \"n\".\"oid\" = \"c\".\"connamespace\" WHERE (\"c\".\"conname\" = $1 AND \"n\".\"nspname\" = $2 AND \"c\".\"conrelid\" = to_regclass($3))) AS \"result\"",
        "params": ["changelog_operation_check", "public", "\"public\".\"changelog\""]
      }
    ]
